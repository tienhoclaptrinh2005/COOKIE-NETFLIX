# Upstash REST credentials (server-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin authentication. Generate the hash with: npm run hash:password -- "your password"
# Use the escaped output locally; use the unescaped output in Vercel's dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
AUTH_SECRET=

# Optional server-to-server cookie verification endpoint.
# For cknetflix, use: https://cknetflix.vercel.app/api/check-info
# Leave the token blank because this public endpoint currently exposes no auth scheme.
CHECKER_API_URL=
CHECKER_API_TOKEN=

# Optional server-to-server VPN intelligence endpoint. Use {ip} in the URL.
# Free VPNAPI.io example (1,000 requests/day): https://vpnapi.io/api/{ip}
# The app automatically sends VPN_CHECK_TOKEN as VPNAPI.io's ?key= parameter.
# IPinfo Plus/Max is also supported: https://api.ipinfo.io/lookup/{ip}/anonymous
VPN_CHECK_URL=
VPN_CHECK_TOKEN=
